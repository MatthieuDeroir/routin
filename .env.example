# ---------------------------------------------------------------------------
# Copier en .env.local (git-ignoré) et compléter. Ne jamais committer de valeur réelle.
# En production, les variables vivent dans Vercel (`vercel env`), pas dans un fichier.
# ---------------------------------------------------------------------------

# Base de données -----------------------------------------------------------
# Développement : fichier SQLite local, aucun token nécessaire.
# Production    : URL libsql:// fournie par `turso db show <db> --url`
#                 + token de `turso db tokens create <db>`
DATABASE_URL="file:./local.db"
DATABASE_AUTH_TOKEN=""

# Auth.js -------------------------------------------------------------------
# Générer avec : npx auth secret
AUTH_SECRET=""
# Google Cloud Console > API et services > Identifiants > ID client OAuth 2.0
# URI de redirection autorisée : http://localhost:3000/api/auth/callback/google
# (et https://<domaine-prod>/api/auth/callback/google en production)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Notifications Web Push ----------------------------------------------------
# Générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@example.com"

# Protège la route de cron appelée par Vercel Cron
CRON_SECRET=""
